 <div class="container">
                <div class="row p-x-1 p-y-3">
                    {% for post in posts %}
                        <div class="col-xs-4 p-y-1">
                            <div class="card card-block">

                                {% if post.featured_images.count %}
                                    <div class="featured-images text-center "> {# card-img-top #}
                                            {% set image = post.featured_images[0] %}
                                            <img 
                                                data-src="{{ image.filename }}"
                                                src="{{ image.path }}"
                                                alt="{{  image.description }}"
                                                style="max-width: 100%" />
                                    </div>
                                {% endif %}

                                <div class="text-sm-right">{{ post.published_at|date('M d, Y') }}</div>
                                <h4 class="card-title text-lg-left">{{ post.title }}</h4>
                                <div class='latest-blog-posts-content-container'>
                                    {{ post.summary }} {{colums}}
                                </div>

                           {#   
                                {% if post.categories.count %} 
                                   {% for category in post.categories %}
                                        <!-- interesing ...  category.url != category.name here :) -->
                                        <a href="{{ category.url }}">{{ category.name }}</a>
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %} 
                                {% endif %}
                            #}
                                <div class="learn-more center-block text-xs-right">
                                    <a href="{{ post.url }}" class="">read more</a>
                                </div>
                            </div>
                        </div>

                    {% else %}
                        <div class="no-data">{{ noPostsMessage }}</div>
                    {% endfor %} 

                    
                </div>        
            </div>