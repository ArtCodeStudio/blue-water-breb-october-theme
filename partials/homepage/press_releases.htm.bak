	<div class="row">
		<div class="card-group">
			{% for post in posts %}
				<div class="col-xs-12 col-md-4">
					<div class="card">
						<div class='content'>
							{% if post.featured_images.count %}
								{% for image in post.featured_images %}
									<img
										data-src="{{ image.filename }}"
										src="{{ image.path }}"
										alt="{{ image.description }}"
										class="card-img-top img-fluid"
									/>
								{% endfor %}

							{% else %}
								<img class="card-img-top img-fluid" src="http://placehold.it/340x173"/>
							{% endif %}
						</div>
						
						<div class="card-block">
							<p class="text-xs-right">{{ post.published_at|date('M d, Y') }}</p>
							<h4 class="card-title text-xs-left">{{ post.title }}</h4>
							<div class='overview-content-container'>
								{{ post.summary }}
							</div>
							<div class="learn-more center-block text-xs-right">
								<a href="{{ post.url }}" class="">read more</a>
							</div>
						</div>
					</div>
				</div>
			{% else %}
				<div class="no-data">{{ noPostsMessage }}</div>
			{% endfor %}
		</div>
	</div>

